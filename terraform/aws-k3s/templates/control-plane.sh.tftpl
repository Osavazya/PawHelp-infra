#!/bin/bash
set -euo pipefail

exec > >(tee /var/log/pawhelp-control-plane.log | logger -t pawhelp-control-plane -s 2>/dev/console) 2>&1

dnf update -y
dnf install -y awscli git jq tar gzip iptables-services
%{ if enable_wireguard ~}
dnf install -y wireguard-tools || true
%{ endif ~}

TOKEN="$(curl -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600' -s http://169.254.169.254/latest/api/token)"
PRIVATE_IP="$(curl -H "X-aws-ec2-metadata-token: $TOKEN" -s http://169.254.169.254/latest/meta-data/local-ipv4)"
INSTANCE_ID="$(curl -H "X-aws-ec2-metadata-token: $TOKEN" -s http://169.254.169.254/latest/meta-data/instance-id)"

if [ -n "${control_plane_eip_allocation_id}" ]; then
  aws ec2 associate-address --region ${aws_region} --instance-id "$INSTANCE_ID" --allocation-id "${control_plane_eip_allocation_id}" --allow-reassociation || true
fi

%{ if enable_wireguard ~}
if command -v wg >/dev/null 2>&1; then
  install -d -m 700 /etc/wireguard
  if [ ! -f /etc/wireguard/server.key ]; then
    wg genkey | tee /etc/wireguard/server.key | wg pubkey > /etc/wireguard/server.pub
    chmod 600 /etc/wireguard/server.key
  fi

  SERVER_PRIVATE_KEY="$(cat /etc/wireguard/server.key)"
  cat >/etc/wireguard/wg0.conf <<EOF
[Interface]
Address = ${wireguard_address}
ListenPort = ${wireguard_port}
PrivateKey = $SERVER_PRIVATE_KEY
SaveConfig = false
PostUp = sysctl -w net.ipv4.ip_forward=1; iptables -A FORWARD -i wg0 -j ACCEPT; iptables -A FORWARD -o wg0 -j ACCEPT
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT || true; iptables -D FORWARD -o wg0 -j ACCEPT || true
EOF

  cat >/tmp/wireguard-peers.json <<'EOF'
${wireguard_peers_json}
EOF

  jq -r '.[] | "\n[Peer]\n# " + .name + "\nPublicKey = " + .public_key + "\nAllowedIPs = " + .allowed_ips' /tmp/wireguard-peers.json >> /etc/wireguard/wg0.conf
  systemctl enable --now wg-quick@wg0 || true

  aws ssm put-parameter --region ${aws_region} --name "${ssm_prefix}/wireguard/server_public_key" --type String --value "$(cat /etc/wireguard/server.pub)" --overwrite
  aws ssm put-parameter --region ${aws_region} --name "${ssm_prefix}/wireguard/endpoint" --type String --value "${control_plane_eip_public_ip}:${wireguard_port}" --overwrite
  aws ssm put-parameter --region ${aws_region} --name "${ssm_prefix}/wireguard/server_address" --type String --value "${wireguard_address}" --overwrite
else
  echo "wireguard-tools was not installed; VPN bootstrap skipped"
fi
%{ endif ~}

curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="server --node-name control-plane-$(hostname) --node-label pawhelp.io/environment=${environment} --node-label node-role.kubernetes.io/control-plane=true --node-taint node-role.kubernetes.io/control-plane=true:NoSchedule --tls-san $PRIVATE_IP --tls-san ${control_plane_eip_public_ip} --write-kubeconfig-mode 644" sh -

until test -f /var/lib/rancher/k3s/server/node-token; do
  sleep 5
done

K3S_TOKEN="$(cat /var/lib/rancher/k3s/server/node-token)"

aws ssm put-parameter --region ${aws_region} --name "${ssm_prefix}/server_url" --type String --value "https://$PRIVATE_IP:6443" --overwrite
aws ssm put-parameter --region ${aws_region} --name "${ssm_prefix}/token" --type SecureString --value "$K3S_TOKEN" --overwrite

export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

until /usr/local/bin/kubectl get nodes >/dev/null 2>&1; do
  sleep 5
done

curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

%{ if enable_argocd ~}
/usr/local/bin/kubectl create namespace argocd --dry-run=client -o yaml | /usr/local/bin/kubectl apply -f -
/usr/local/bin/kubectl apply -n argocd -f https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml

%{ if enable_wireguard ~}
cat >/tmp/argocd-internal-ingress.yaml <<EOF
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: argocd-vpn-only
  namespace: argocd
spec:
  ipAllowList:
    sourceRange:
${internal_access_cidr_blocks_yaml}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: argocd-internal
  namespace: argocd
  annotations:
    traefik.ingress.kubernetes.io/router.middlewares: argocd-argocd-vpn-only@kubernetescrd
    traefik.ingress.kubernetes.io/service.serversscheme: https
spec:
  ingressClassName: traefik
  rules:
    - host: argocd.${environment}.pawhelp.internal
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: argocd-server
                port:
                  name: https
EOF

until /usr/local/bin/kubectl -n argocd get deployment argocd-server >/dev/null 2>&1; do
  sleep 5
done
/usr/local/bin/kubectl apply -f /tmp/argocd-internal-ingress.yaml || true
%{ endif ~}

%{ if git_repo_url != "" ~}
cat >/tmp/pawhelp-root.yaml <<'EOF'
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: pawhelp-root
  namespace: argocd
spec:
  project: default
  source:
    repoURL: ${git_repo_url}
    targetRevision: ${git_target_revision}
    path: argocd/environments/${environment}
    directory:
      recurse: true
      include: '*.yaml'
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
EOF

until /usr/local/bin/kubectl -n argocd get deployment argocd-server >/dev/null 2>&1; do
  sleep 5
done

/usr/local/bin/kubectl apply -f /tmp/pawhelp-root.yaml
%{ endif ~}
%{ endif ~}
